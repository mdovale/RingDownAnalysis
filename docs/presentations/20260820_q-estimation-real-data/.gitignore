# Build outputs, regenerated by `make`.
slides.pdf
slides-notes.pdf
_review/

# Cached real-data extracts and raster figure previews: large and rebuildable
# from the raw records via `make cache`.
assets/_cache/
assets/_preview/

# The figure PDFs are shipped assets, not build noise: without them the deck
# cannot be rebuilt by anyone who lacks the raw phasemeter records. Override the
# repository-wide *.pdf rule for them.
!assets/*.pdf
